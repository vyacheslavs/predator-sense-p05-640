#!/bin/sh
set -e
PKG=predator-wmi
VER=@VERSION@

if [ -d /run/systemd/system ]; then
    systemctl stop predator-led.service >/dev/null 2>&1 || true
    if [ "$1" = remove ]; then
        systemctl disable predator-led.service >/dev/null 2>&1 || true
    fi
fi
rmmod predator_wmi 2>/dev/null || true
if dkms status -m $PKG -v $VER | grep -q .; then
    dkms remove -m $PKG -v $VER --all || true
fi
exit 0
